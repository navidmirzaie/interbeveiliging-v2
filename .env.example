# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Database (Drizzle direct connection)
DATABASE_URL=postgresql://postgres:[password]@db.xxxx.supabase.co:5432/postgres

# AI (server-side only — never expose to client)
ANTHROPIC_API_KEY=sk-ant-...

# Email (server-side only)
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=rooster@interbeveiliging.nl

# Cron (validates scheduled function calls)
CRON_SECRET=your-random-32-char-secret-here

# Auto-set by Netlify in production
URL=http://localhost:3000
